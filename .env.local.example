# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit it.

# Generate a secret:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-32-byte-random-base64-string

# Local dev URL (change for Vercel/production deployments)
SESSION_URL=http://localhost:3000
